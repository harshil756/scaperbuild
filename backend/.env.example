APP_NAME="7 States Pest Control"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=7state
DB_USERNAME=myuser
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=contact@7statespestcontrol.com.au
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=contact@7statespestcontrol.com.au
MAIL_FROM_NAME="7 States Pest Control"

# Contact / lead notification recipients
CONTACT_MAIL_TO=7statespestcontrol@gmail.com
CONTACT_MAIL_CC=gbhonu@gmail.com
# Optional comma-separated BCC (e.g. test inbox during setup)
CONTACT_MAIL_BCC=harshilsoni605@gmail.com
CONTACT_SITE_URL=https://7statespestcontrol.com.au
CONTACT_PHONE="+61 434 660 060"
CONTACT_PHONE_TEL=+61434660060
CONTACT_PUBLIC_EMAIL=7statespestcontrol@gmail.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
