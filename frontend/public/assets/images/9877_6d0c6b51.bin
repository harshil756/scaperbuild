55.4-55.5c-6.2-6.3-16.4-6.3-22.6 0L68.7 146c-6.2 6.3-6.2 16.4 0 22.6l112 112.2z\"><\/path><\/svg>\t\t\t\t\t\t<\/span>\n\t\t\t\t\t\t\t\t\t\t<span class=\"elementor-icon-list-text\">Keep yards open and well-maintained<\/span>\n\t\t\t\t\t\t\t\t\t<\/li>\n\t\t\t\t\t\t<\/ul>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-815a5c7 e-con-full e-flex e-con e-child\" data-id=\"815a5c7\" data-element_type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-532a940 e-con-full e-flex e-con e-child\" data-id=\"532a940\" data-element_type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-c783a42 e-con-full e-flex e-con e-child\" data-id=\"c783a42\" data-element_type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-326f094 elementor-widget elementor-widget-heading\" data-id=\"326f094\" data-element_type=\"widget\" data-settings=\"{&quot;_animation&quot;:&quot;none&quot;}\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">protects<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-010327e elementor-widget elementor-widget-heading\" data-id=\"010327e\" data-element_type=\"widget\" data-settings=\"{&quot;_animation&quot;:&quot;none&quot;}\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">How to Prevent Fox Infestations ?<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-3b60541 e-con-full e-flex e-con e-child\" data-id=\"3b60541\" data-element_type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-7696069 elementor-widget elementor-widget-text-editor\" data-id=\"7696069\" data-elemen