bc2db\" data-element_type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-6501e7d elementor-widget elementor-widget-heading\" data-id=\"6501e7d\" data-element_type=\"widget\" data-settings=\"{&quot;_animation&quot;:&quot;none&quot;}\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">FOx special<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-578d989 elementor-widget elementor-widget-heading\" data-id=\"578d989\" data-element_type=\"widget\" data-settings=\"{&quot;_animation&quot;:&quot;none&quot;}\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Types of Fox Issues We Control<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-c0c2f1e e-con-full e-flex e-con e-child\" data-id=\"c0c2f1e\" data-element_type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-f6bb8ec elementor-widget elementor-widget-text-editor\" data-id=\"f6bb8ec\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p>Fox infestations can create serious risks to safety, property, and local wildlife. Our <strong data-start=\"1399\" data-end=\"1436\">fox control services in Melbourne<\/strong> are designed to handle all types of fox-related problems, including:<\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-e9cbe7b elementor-widget-divider--view-line elementor-widget elementor-widget-divider\" data-id=\"e9cbe7b\" data-element_type=\"widget\" data-widget_type=\"divider.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<div class=\"elementor-divider\">\n\t\t\t<