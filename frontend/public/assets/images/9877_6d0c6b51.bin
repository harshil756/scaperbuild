izes&quot;:[]},&quot;_transform_translateY_effect_hover_mobile&quot;:{&quot;unit&quot;:&quot;px&quot;,&quot;size&quot;:&quot;&quot;,&quot;sizes&quot;:[]}}\">\n\t\t\t\t<div class=\"elementor-element elementor-element-be021bf elementor-position-top elementor-widget elementor-widget-image-box\" data-id=\"be021bf\" data-element_type=\"widget\" data-widget_type=\"image-box.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"elementor-image-box-wrapper\"><figure class=\"elementor-image-box-img\"><img fetchpriority=\"high\" decoding=\"async\" width=\"612\" height=\"408\" src=\"https:\/\/7statespestcontrol.com.au\/wp-content\/uploads\/2025\/12\/istockphoto-1406487768-612x612-1.jpg\" class=\"attachment-full size-full wp-image-9892\" alt=\"\" srcset=\"https:\/\/7statespestcontrol.com.au\/wp-content\/uploads\/2025\/12\/istockphoto-1406487768-612x612-1.jpg 612w, https:\/\/7statespestcontrol.com.au\/wp-content\/uploads\/2025\/12\/istockphoto-1406487768-612x612-1-300x200.jpg 300w\" sizes=\"(max-width: 612px) 100vw, 612px\" \/><\/figure><div class=\"elementor-image-box-content\"><h3 class=\"elementor-image-box-title\">1. Urban Fox Activity<\/h3><p class=\"elementor-image-box-description\">Urban foxes frequently enter backyards, raid bins, and attack pets. Their presence in residential areas requires professional fox control services to prevent escalation.<\/p><\/div><\/div>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-9cd4270 e-con-full e-transform e-transform e-flex e-con e-child\" data-id=\"9cd4270\" data-element_type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;,&quot;_transform_translateY_effect_hover&quot;:{&quot;unit&quot;:&quot;px&quot;,&quot;size&quot;:10,&quot;sizes&quot;:[]},&quot;_transform_translateX_effect&quot;:{&quot;unit&quot;:&quot;px&quot;,&quot;size&quot;:&quot;&quot;,&quot;sizes&quot;:[]},&quot;_transform_translateX_effect_tablet&q