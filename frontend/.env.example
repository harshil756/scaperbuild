# Laravel API base URL (no trailing slash, do NOT include /api)
# Production — MUST be https:// (http:// causes Mixed Content / blocked API on the live site)
VITE_API_URL=https://7sbd.7statespestcontrol.com.au

# Public site URL used when syncing sitemaps/robots (no trailing slash)
# VITE_SITE_URL=https://7statespestcontrol.com.au

# Local dev (uncomment and comment production line above):
# VITE_API_URL=http://127.0.0.1:8000
# Or leave VITE_API_URL empty to use Vite proxy: /api → http://127.0.0.1:8000
