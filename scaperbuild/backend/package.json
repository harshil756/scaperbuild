{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "cms:extract": "node scripts/extract-home-cms.mjs",
        "cms:copy": "node scripts/copy-home-assets.mjs",
        "cms:seed": "php artisan db:seed --class=HomePageSeeder",
        "cms:sync": "npm run cms:extract && npm run cms:copy && npm run cms:seed"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    }
}
