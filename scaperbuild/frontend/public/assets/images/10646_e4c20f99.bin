pp-Image-2026-06-05-at-1.30.41-PM-1.jpeg\",\"contentUrl\":\"https:\/\/7statespestcontrol.com.au\/wp-content\/uploads\/2026\/06\/WhatsApp-Image-2026-06-05-at-1.30.41-PM-1.jpeg\",\"width\":1200,\"height\":630,\"caption\":\"wasp nest removal melbourne cost\"},{\"@type\":\"BreadcrumbList\",\"@id\":\"https:\/\/7statespestcontrol.com.au\/wasp-nest-control-melbourne-7-proven-ways-to-keep-your-property-wasp-free\/#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https:\/\/7statespestcontrol.com.au\/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Wasp Nest Control Melbourne: 7 Proven Ways to Keep Your Property Wasp-Free\"}]},{\"@type\":\"WebSite\",\"@id\":\"https:\/\/7statespestcontrol.com.au\/#website\",\"url\":\"https:\/\/7statespestcontrol.com.au\/\",\"name\":\"7 States Pest Control\",\"description\":\"\",\"publisher\":{\"@id\":\"https:\/\/7statespestcontrol.com.au\/#organization\"},\"potentialAction\":[{\"@type\":\"SearchAction\",\"target\":{\"@type\":\"EntryPoint\",\"urlTemplate\":\"https:\/\/7statespestcontrol.com.au\/?s={search_term_string}\"},\"query-input\":{\"@type\":\"PropertyValueSpecification\",\"valueRequired\":true,\"valueName\":\"search_term_string\"}}],\"inLanguage\":\"en-US\"},{\"@type\":\"Organization\",\"@id\":\"https:\/\/7statespestcontrol.com.au\/#organization\",\"name\":\"7 States Pest Control\",\"url\":\"https:\/\/7statespestcontrol.com.au\/\",\"logo\":{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\/\/7statespestcontrol.com.au\/#\/schema\/logo\/image\/\",\"url\":\"https:\/\/7statespestcontrol.com.au\/wp-content\/uploads\/2025\/06\/7-states-logo-1.png-1.webp\",\"contentUrl\":\"https:\/\/7statespestcontrol.com.au\/wp-content\/uploads\/2025\/06\/7-states-logo-1.png-1.webp\",\"width\":344,\"height\":105,\"caption\":\" 7 States Pest Control\"},\"image\":{\"@id\":\"https:\/\/7statespestcontrol.com.au\/#\/schema\/logo\/image\/\"}},{\"@type\":\"Person\",\"@id\":\"https:\/\/7state